extends base

block content
    main.auth
        .auth__form
            h2 Create your account

            form#signup-form

                .form-group
                    label(for="name") Name
                    input#name(
                        type="text"
                        placeholder="Your name"
                        required
                    )

                .form-group
                    label(for="email") Email
                    input#email(
                        type="email"
                        placeholder="your@email.com"
                        required
                    )

                .form-group
                    label(for="password") Password
                    input#password(
                        type="password"
                        placeholder="********"
                        required
                    )

                .form-group
                    label(for="passwordConfirm") Confirm Password
                    input#passwordConfirm(
                        type="password"
                        placeholder="********"
                        required
                    )


                button.btn.btn--green(type="submit")
                    | Create Account