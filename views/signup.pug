extends base

block content
    main.auth
        .auth__card

            //- LEFT SIDE
            section.auth__intro
                .auth__intro-content
                    .auth__eyebrow
                        span 🌍
                        | AI Travel

                    h1
                        | Your next
                        br
                        | adventure starts here.

                    p
                        | Create your account, save your travel plans,
                        | and let your AI travel assistant help you
                        | plan smarter.

                    .auth__features
                        .auth__feature
                            span.auth__feature-icon ✓
                            span Save your travel conversations

                        .auth__feature
                            span.auth__feature-icon ✓
                            span Plan and organize your trips

                        .auth__feature
                            span.auth__feature-icon ✓
                            span Get personalized travel assistance


            //- RIGHT SIDE
            section.auth__form-section

                .auth__header
                    p.auth__welcome Create your account
                    h2 Start your journey
                    p Join your AI-powered travel assistant today.

                form#signup-form.auth__form

                    .form__group
                        label.form__label(for="name") Full Name
                        input#name.form__input(
                            type="text"
                            placeholder="Enter your full name"
                            required
                        )

                    .form__group
                        label.form__label(for="email") Email Address
                        input#email.form__input(
                            type="email"
                            placeholder="Enter your email"
                            required
                        )

                    .form__group
                        label.form__label(for="password") Password
                        input#password.form__input(
                            type="password"
                            placeholder="Create a password"
                            required
                        )

                    .form__group
                        label.form__label(for="passwordConfirm") Confirm Password
                        input#passwordConfirm.form__input(
                            type="password"
                            placeholder="Confirm your password"
                            required
                        )

                    button.btn.btn--green.btn--signup(type="submit")
                        | Create Account

                p.auth__footer
                    | Already have an account?
                    a(href="/login") Log in