extends base

block content
  main.auth
    section.auth__container
        h1.auth__title Reset your password

        p.auth__copy
            | Choose a strong new password for your AI Travel Assistant account.

        form#reset-password-form.form
            input#reset-token(
            type='hidden'
            value=token
            )

            .form__group
            label.form__label(for='password') New password
            input.form__input(
                id='password'
                type='password'
                name='password'
                placeholder='Create a new password'
                required
                minlength='8'
            )

            .form__group
            label.form__label(for='passwordConfirm') Confirm new password
            input.form__input(
                id='passwordConfirm'
                type='password'
                name='passwordConfirm'
                placeholder='Confirm your new password'
                required
                minlength='8'
            )

            .form__group
            button.btn.btn--green(type='submit')
                | Reset password

        .auth__footer
            p Remembered your password?
            a(href='/login') Back to login

        