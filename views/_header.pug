nav.overview-nav(aria-label='Main')
    a.overview-brand(href='/')
        span.logo-icon(aria-hidden='true') ✈
        span.overview-brand__text
            strong AI Travel
            small Knowledge Assistant

    .overview-links
        a.overview-link(href='/') Trips
        a.overview-link(href='/assistant') Assistant

    .auth-bar
        if user
            a.nav-user(href='/me' aria-label='Your account')
                img.nav-user__img(
                    src=`/img/users/${user.photo || 'default-user.jpg'}`,
                    alt=`Photo of ${user.name}`
                )
                span.nav-user__name= user.name.split(' ')[0]
            a.btn-auth.btn-auth--ghost.nav__el--logout(href='#') Log out
        else
            a.btn-auth.btn-auth--ghost(href='/login') Log in
            a.btn-auth.btn-auth--solid(href='/signup') Sign up
