extends base

block content
    main.auth
        section.auth__container
            h1.auth__title Forgot your password?

            p.auth__copy
                | No worries. Enter the email address associated with your account
                | and we'll send you a link to reset your password.
            form#forgot-password-form.form
                .form__group
                label.form__label(for='email') Email address
                input.form__input(
                    id='email'
                    type='email'
                    name='email'
                    placeholder='you@example.com'
                    required
                )
                .form__group
                button.btn.btn--green(type='submit')
                    | Send reset link
            .auth__footer
                p Remember your password?
                a(href='/login') Back to login