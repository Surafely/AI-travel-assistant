extends base

block content
    main.assistant
        #toast-container.toast-container

        // Mobile overlay
        .sidebar-overlay

        aside.assistant__sidebar

            button.sidebar-close(type="button") ✕

            .assistant__logo
                h2 🌍 AI Travel
                p Knowledge Assistant

            .assistant__sidebar-header
                button.btn.btn--green.btn--new-chat(type="button")
                    | + New Chat

            h4.sidebar__title Recent Conversations

            ul#conversation-list.conversation-list

        section.assistant__chat

            header.assistant__chat-header

                button.sidebar-toggle(type="button") ☰

                .chat-header-content
                    h1 AI Travel Assistant
                    p Plan smarter. Travel better.

            #messages.messages

            form.chat-form

                .chat-input-wrapper

                    textarea.chat-input(
                        rows="1"
                        placeholder="Ask me anything about your next trip..."
                    )

                    button.btn.btn--send(type="submit")
                        | ➜