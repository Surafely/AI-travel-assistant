//- Email template adapted from https://github.com/leemunroe/resp onsive-html-email-template
//- Converted from HTML using https://html2pug.now.sh/

doctype html
html
  head
    meta(name='viewport', content='width=device-width')
    meta(http-equiv='Content-Type', content='text/html; charset=UTF-8')
    title= subject

    include _style.pug
  body
    table.body(
      role='presentation',
      border='0',
      cellpadding='0',
      cellspacing='0'
    )
      tbody
        tr
          td
          td.container
            .content
              // START CENTERED EMAIL CONTAINER
              table.main(role='presentation')
                // START MAIN AREA
                tbody
                  tr
                    td.email-header
                      .brand-mark ✈
                      p.brand-kicker AI Travel
                      h1= subject
                  tr
                    td.wrapper
                      table(
                        role='presentation',
                        border='0',
                        cellpadding='0',
                        cellspacing='0'
                      )
                        tbody
                          tr
                            td
                              // CONTENT
                              block content
              // START FOOTER
              .footer
                table(
                  role='presentation',
                  border='0',
                  cellpadding='0',
                  cellspacing='0'
                )
                  tbody
                    tr
                      td.content-block
                        span.apple-link AI Travel Knowledge Assistant
                        br
                        |
                        | Curated trips, smarter planning, and practical travel guidance.
                        br
                        a(href=url) Visit your travel workspace
          //- td  
